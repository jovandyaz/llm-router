{
  "name": "@jovandyaz/llm-router",
  "version": "0.2.0",
  "description": "In-process LLM router: provider fallback chain with cooldowns that never switches models mid-stream, model catalog with pricing and context windows, prompt-injection guard and token estimator.",
  "keywords": [
    "llm",
    "llm-router",
    "router",
    "failover",
    "ai",
    "model-catalog",
    "pricing",
    "fallback",
    "circuit-breaker",
    "prompt-injection",
    "tokens",
    "openrouter",
    "models.dev"
  ],
  "homepage": "https://github.com/jovandyaz/llm-router#readme",
  "bugs": {
    "url": "https://github.com/jovandyaz/llm-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jovandyaz/llm-router.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "catalog": [
        "./dist/catalog.d.mts"
      ],
      "chain": [
        "./dist/chain.d.mts"
      ],
      "guard": [
        "./dist/guard.d.mts"
      ],
      "tokens": [
        "./dist/tokens.d.mts"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./catalog": "./dist/catalog.mjs",
    "./chain": "./dist/chain.mjs",
    "./guard": "./dist/guard.mjs",
    "./tokens": "./dist/tokens.mjs",
    "./package.json": "./package.json",
    "./model-index.json": "./data/model-index.json",
    "./model-index.schema.json": "./data/model-index.schema.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:consumers": "vitest run --config vitest.consumers.config.ts",
    "examples": "tsc -p examples && node --test \"examples/*.ts\"",
    "snapshot:refresh": "tsx scripts/refresh-snapshot.ts",
    "schema:write": "tsx scripts/write-model-index-schema.ts",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ai": "7.0.161",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
